# Cloudflare Pages Headers
# Cache static assets aggressively
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Search indexes: versioned by deploy, cached at the edge and revalidated in browsers
/search-index.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

/search-index-zh.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

/search-index-en.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

# XML Sitemaps: Fresh but with correct content type
/*.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/*.txt
  Content-Type: text/plain; charset=utf-8

# HTML Files: Always fresh
/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

# Modern Security Headers (Lighthouse Best Practices 90+)
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://hm.baidu.com https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https://api.xbstack.com https://hm.baidu.com https://*.baidu.com https://comments.xbstack.com https://www.google-analytics.com https://region1.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.doubleclick.net https://cloudflareinsights.com; frame-src 'self' https://comments.xbstack.com;
