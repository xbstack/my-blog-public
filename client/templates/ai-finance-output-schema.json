{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.xbstack.com/templates/ai-finance-output-schema.json",
  "title": "XBSTACK AI Financial Report Extraction Output",
  "description": "A review-oriented schema for financial report extraction. It requires source references for material metrics and keeps review status explicit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "company", "metrics", "risk_factors", "review"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_type", "report_period", "currency", "source_name"],
      "properties": {
        "document_type": { "type": "string", "enum": ["annual_report", "10-k", "10-q", "earnings_release", "transcript", "other"] },
        "report_period": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 8 },
        "source_name": { "type": "string", "minLength": 1 },
        "source_url": { "type": ["string", "null"], "format": "uri" },
        "file_hash": { "type": ["string", "null"] }
      }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ticker": { "type": ["string", "null"] },
        "market": { "type": ["string", "null"] },
        "industry": { "type": ["string", "null"] }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit", "period", "source_page", "evidence", "confidence", "review_status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": ["number", "string", "null"] },
          "unit": { "type": ["string", "null"] },
          "period": { "type": "string", "minLength": 1 },
          "source_page": { "type": ["integer", "null"], "minimum": 1 },
          "evidence": { "type": ["string", "null"], "maxLength": 1200 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "review_status": { "type": "string", "enum": ["pending", "needs_review", "reviewed", "rejected"] }
        }
      }
    },
    "risk_factors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "summary", "source_page", "evidence", "confidence", "review_status"],
        "properties": {
          "category": { "type": "string", "enum": ["liquidity", "debt", "customer_concentration", "litigation", "impairment", "guidance", "regulatory", "operations", "other"] },
          "summary": { "type": "string", "minLength": 1 },
          "source_page": { "type": ["integer", "null"], "minimum": 1 },
          "evidence": { "type": ["string", "null"], "maxLength": 1600 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "review_status": { "type": "string", "enum": ["pending", "needs_review", "reviewed", "rejected"] }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_human_review", "missing_evidence_count", "warnings"],
      "properties": {
        "requires_human_review": { "type": "boolean" },
        "missing_evidence_count": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "reviewed_by": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
